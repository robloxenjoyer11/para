# ── База ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/para"

# ── Безопасность (в проде обязательно свои длинные значения: openssl rand -hex 32) ──
JWT_SECRET="change-me-to-a-long-random-secret"
ENCRYPTION_KEY=""            # шифрует сессии Modeus в БД; если пусто — берётся JWT_SECRET

# ── Telegram ──
BOT_TOKEN=""                 # от @BotFather (если токен светился в чате — перевыпусти: /revoke)
WEBAPP_URL=""                # публичный HTTPS-адрес мини-аппа, напр. https://xxxx.trycloudflare.com
BOT_MODE="polling"           # polling | off

# ── Адреса ──
PORT=3001
APP_ORIGIN="http://localhost:5173"   # откуда ходит фронт в dev (CORS)
PUBLIC_URL=""                # публичный адрес API для ссылок в письмах; пусто → WEBAPP_URL

# ── Почта ──
# На бесплатном Render SMTP-порты заблокированы → используй HTTP API (достаточно одного ключа):
# RESEND_API_KEY=""   (resend.com; MAIL_FROM должен быть на подтверждённом домене)
# BREVO_API_KEY=""    (brevo.com; MAIL_FROM — подтверждённый отправитель)
# Иначе — обычный SMTP:
# Яндекс:  smtp.yandex.ru     465  (нужен пароль приложения)
# Mail.ru: smtp.mail.ru       465  (пароль для внешних приложений)
# Gmail:   smtp.gmail.com     587  (пароль приложения, включить 2FA)
# Свой домен / Resend / Mailgun / Brevo — host и порт из кабинета
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ПАРА <no-reply@example.com>"   # адрес должен принадлежать SMTP_USER / вашему домену

# ── Modeus ТюмГУ ──
MODEUS_BASE_URL="https://utmn.modeus.org"
MODEUS_TZ="Asia/Yekaterinburg"
MODEUS_UTC_OFFSET="+05:00"
# Если автоопределение не сработало — возьми из DevTools → Network:
# MODEUS_AUTH_URL=""
# MODEUS_CLIENT_ID=""
# MODEUS_SEARCH_PATH="/schedule-calendar-v2/api/calendar/events/search"
MODEUS_DEBUG=0               # 1 → печатать цепочку редиректов входа (без паролей и токенов)
MODEUS_MOCK=0                # 1 → тестовое расписание без входа в Modeus (для проверки интерфейса)
